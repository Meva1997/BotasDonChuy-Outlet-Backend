##############################################################################
# Botas Don Chuy Outlet — backend
#
# PLANTILLA de configuración. Este archivo SÍ se versiona y NO se carga solo:
#
#     cp .env.example .env
#
# y llena los valores. `.env` está en .gitignore — nunca lo commitees.
#
# Los ejemplos apuntan a DESARROLLO/SANDBOX. Para producción hay que cambiar,
# como mínimo: NODE_ENV, las llaves de Stripe (live), SKYDROPX_BASE_URL y sus
# credenciales, CORS_ORIGIN, FRONTEND_URL y TRUST_PROXY.
#
# Toda la configuración de esta app entra por variables de entorno; no hay
# archivo de config alterno. Las marcadas OBLIGATORIA hacen que el proceso
# falle al arrancar (fail-fast deliberado, en src/config/*). Las opcionales
# caen a su default con un aviso si están mal escritas, sin tumbar el server
# (ver `positiveNumberEnv` / `booleanEnv` en src/utils/env.ts).
##############################################################################

# ── Núcleo ──────────────────────────────────────────────────────────────────

# OBLIGATORIA. Cadena de conexión a PostgreSQL, usada por la app y por
# sequelize-cli. No tiene guard propio: si falta, Sequelize revienta con un
# `TypeError [ERR_INVALID_ARG_TYPE]` críptico al arrancar.
#
# ⚠️ Si el proveedor exige TLS, NO basta con `?sslmode=require` en la cadena:
# Sequelize descarta esa clave antes de pasársela a `pg` y la conexión se abre
# SIN cifrar, en silencio. Usa DATABASE_SSL (abajo). Ver src/config/databaseSsl.ts.
DATABASE_URL=postgres://usuario:password@host:5432/basededatos

# Opcional (default: false). Enciende TLS en la conexión a Postgres — la única
# forma que sí funciona (ver el aviso de arriba). Apagado por default porque un
# Postgres local de desarrollo no habla TLS. En un PaaS con la base en la MISMA
# región (red privada, p. ej. la URL interna de Render) tampoco hace falta; sí
# para cualquier conexión desde fuera del proveedor.
DATABASE_SSL=false

# Opcional (default: true). Ponla en false SOLO si el proveedor sirve un
# certificado autofirmado. El tráfico sigue cifrado, pero deja de verificarse
# con quién se está hablando: que sea una decisión, no un default.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Opcional (default: 4000). Puerto HTTP del server y `servers[]` del spec OpenAPI.
# En un PaaS normalmente lo inyecta el proveedor y no hay que declararla.
PORT=4000

# Opcional. Gatea el arranque real, los tres crons, el log de SQL, el nivel de
# pino y las docs. Valores: development | production | test
NODE_ENV=development

# Opcional, pero NO la dejes vacía en producción: sin ella `cors()` acepta
# CUALQUIER origen. Lista separada por comas (se hace split + trim).
CORS_ORIGIN=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────────────────────

# OBLIGATORIA. Secreto con el que se firman y verifican los JWT del panel.
# Usa una cadena larga y aleatoria (p. ej. `openssl rand -base64 48`).
JWT_SECRET=un_secreto_largo_y_aleatorio

# Opcional (default: 7d). Vigencia del token que emite el login. Un valor
# vacío NO significa "sin límite": cae al default de 7 días a propósito, porque
# un token sin expiración no se puede revocar (no hay lista de revocación).
JWT_EXPIRES_IN=7d

# Opcional (default: 10). Costo de bcrypt al hashear contraseñas de admin.
# Subirlo endurece el hash y hace más lento cada login. El CI usa 4 por velocidad.
BCRYPT_ROUNDS=10

# ── Cloudinary (imágenes de producto y logo) ────────────────────────────────
# Las tres son OBLIGATORIAS: el server no arranca sin ellas.

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Stripe (pagos) ──────────────────────────────────────────────────────────
# Las dos primeras son OBLIGATORIAS: el server no arranca sin ellas.

# Llave secreta, o una restricted key con permiso de PaymentIntents + Refunds.
# Producción usa sk_live_… / rk_live_…
STRIPE_SECRET_KEY=sk_test_...

# Secreto de firma del webhook. El de test y el de live son DISTINTOS: en local
# sale de `stripe listen`, en producción del endpoint del dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# Opcional (default: mxn). Divisa de cobro, ISO-4217 en minúsculas.
STRIPE_CURRENCY=mxn

# Opcional (default: 30). Minutos tras los que una orden `pending` sin pagar se
# considera abandonada y se recicla su stock.
PENDING_ORDER_TTL_MINUTES=30

# Opcional (default: 10). Cada cuántos minutos corre ese barrido.
PENDING_ORDER_SWEEP_INTERVAL_MINUTES=10

# ── Resend (correo transaccional) ───────────────────────────────────────────
# Las dos primeras son OBLIGATORIAS: el server no arranca sin ellas.

RESEND_API_KEY=re_...

# Remitente de todos los correos. Requiere dominio verificado en Resend; sin
# él hay que usar onboarding@resend.dev, que SOLO entrega al dueño de la cuenta
# (a cualquier otro Resend responde 403 y el envío se pierde en silencio).
EMAIL_FROM=Botas Don Chuy Outlet <no-reply@botasdonchuy.com>

# Opcional (default: http://localhost:3000). Base de los links que van DENTRO
# de los correos. Con el valor de desarrollo, cada correo de seguimiento manda
# al comprador a localhost — revisar antes de lanzar.
FRONTEND_URL=http://localhost:3000

# ── Skydropx (cotización en vivo + guía automática) ─────────────────────────
# Las tres credenciales y los ocho SHIP_FROM_* son OBLIGATORIOS.

SKYDROPX_CLIENT_ID=...
SKYDROPX_CLIENT_SECRET=...

# Secreto HMAC-SHA512 con el que se verifica cada evento del webhook de envíos.
SKYDROPX_WEBHOOK_SECRET=...

# Opcional (default: https://sb-pro.skydropx.com, el sandbox).
# Producción es https://pro.skydropx.com — ojo: la cuenta de producción NO tiene
# sandbox propio, así que cada guía de prueba gasta saldo real.
SKYDROPX_BASE_URL=https://sb-pro.skydropx.com

# Opcional. Sin definir se cotizan TODAS las paqueterías. Slugs `provider_name`
# en minúsculas separados por comas; menos proveedores = respuesta más rápida.
SKYDROPX_CARRIERS=dhl,paquetexpress

# Opcional (default: 15). Espera antes de reintentar una guía que falló, y
# antigüedad a partir de la cual un centinela "creating" cuenta como huérfano.
SHIPMENT_RETRY_DELAY_MINUTES=15

# Opcional (default: 10). Cada cuántos minutos corre el barrido de guías pendientes.
SHIPMENT_RETRY_SWEEP_INTERVAL_MINUTES=10

# Domicilio de origen de la guía. Los ocho son OBLIGATORIOS.
SHIP_FROM_STREET=Nombre de la calle
SHIP_FROM_EXTERNAL_NUMBER=123
SHIP_FROM_NEIGHBORHOOD=Centro
SHIP_FROM_CITY=Celaya
SHIP_FROM_STATE=Guanajuato
SHIP_FROM_POSTAL_CODE=38000
SHIP_FROM_NAME=Botas Don Chuy
SHIP_FROM_PHONE=4610000000

# ── Logging y monitoreo ─────────────────────────────────────────────────────
# Todas opcionales; nada de esto bloquea el arranque.

# Default: silent en test, info en producción, debug en el resto.
# Valores: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Sin valor, Sentry queda deshabilitado (solo se avisa en el log). Es
# monitoreo opt-in, no una dependencia del negocio.
SENTRY_DSN=

# Destinatario de las ALERTAS OPERATIVAS (algo se rompió: una guía que no se
# pudo generar, un correo que no salió, un pago contra un pedido cancelado).
# Sin valor, la alerta se omite con un aviso en el log.
ALERT_EMAIL_TO=tu_correo@ejemplo.com

# ── Despliegue detrás de un proxy ───────────────────────────────────────────

# Opcional, pero NECESARIA si hay un proxy delante (Render, Railway, Fly, nginx,
# Cloudflare). Es el valor que recibe `app.set("trust proxy", …)` y de él depende
# `req.ip`: sin ella, los cinco rate limiters dejan de contar por cliente y pasan
# a ser UN SOLO cupo para toda la tienda.
# No viene activada por defecto a propósito: confiar en el X-Forwarded-For de un
# servidor expuesto directamente permitiría saltarse los límites con IPs inventadas.
# Acepta: 1 (número de saltos, empieza aquí en un PaaS) | true | false |
# loopback | 10.0.0.0/8 | una lista separada por comas.
TRUST_PROXY=

# ── Documentación de la API ─────────────────────────────────────────────────

# Opcional (default: encendida fuera de producción, APAGADA en producción).
# Sirve Swagger UI en /api/docs y el spec crudo en /api/docs.json. Ponerla en
# `true` las reabre en producción sin tocar código, para depurar contra el
# despliegue real. Acepta true | false | 1 | 0.
API_DOCS_ENABLED=

# ── Healthcheck ─────────────────────────────────────────────────────────────

# Opcional (default: 3000). Margen del chequeo de BD en GET /health/ready.
HEALTH_READY_TIMEOUT_MS=3000

# ── Cupones / checkout ──────────────────────────────────────────────────────

# Opcional (default: 10). Total mínimo en pesos que acepta el checkout; es el
# mínimo que Stripe cobra en MXN.
MIN_CHARGE_MXN=10

# ── Avisos de venta al dueño ────────────────────────────────────────────────
# Opcionales, pero SIN destinatario la fase queda apagada por completo.

# Destino del aviso por venta nueva y del resumen diario. Si falta, cae a
# ALERT_EMAIL_TO. Está aparte para poder filtrar/silenciar "vendiste algo"
# independientemente de "algo se rompió".
OWNER_NOTIFICATION_EMAIL=duenio@ejemplo.com

# Opcional (default: 8). Hora local (Celaya) del resumen del día anterior.
# Rango válido 1–23: `positiveNumberEnv` rechaza el 0.
DAILY_DIGEST_HOUR=8

# Opcional (default: 15). Cada cuánto se revisa si ya toca mandarlo.
DAILY_DIGEST_CHECK_INTERVAL_MINUTES=15

# ── Alta del primer usuario admin ───────────────────────────────────────────
# Solo las lee `node dist/scripts/bootstrapAdmin.js`, nunca el server. Se pasan
# en la invocación del script; no hace falta dejarlas puestas en el .env.
#
#     BOOTSTRAP_ADMIN_EMAIL=duenio@botasdonchuy.com \
#     BOOTSTRAP_ADMIN_PASSWORD='TuContra1@' \
#       node dist/scripts/bootstrapAdmin.js
#
# La contraseña debe cumplir lo mismo que exige el login (8+ caracteres, una
# mayúscula, un número y un signo de !@#$%^&*(),.?":{}|<>_-+=), o se crearía
# una cuenta que no puede iniciar sesión.
#
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Admin          # opcional (default: Admin)
# BOOTSTRAP_ADMIN_ROLE=owner          # opcional (default: owner) — owner | admin
# BOOTSTRAP_RESET_PASSWORD=true       # reescribe la contraseña si el correo ya existe

##############################################################################
# Nota sobre las credenciales de producción de Skydropx: los mensajes de error
# de src/config/skydropx.ts sugieren guardarlas como SKYDROPX_CLIENT_ID_PROD y
# SKYDROPX_CLIENT_SECRET_PROD (comentadas junto a las de sandbox). Son solo una
# convención de dónde dejarlas anotadas: NINGÚN código las lee. Al pasar a
# producción hay que copiar sus valores a SKYDROPX_CLIENT_ID/_SECRET.
##############################################################################
